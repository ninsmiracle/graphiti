        {
          "start_sec": 1118.5,
          "end_sec": 1120.5,
          "speaker": "myself",
          "maps_to": "p1",
          "text": "而且我不知道他要创我。"
        },
        {
          "start_sec": 1200.0,
          "end_sec": 1201.5,
          "speaker": "SPEAKER_02",
          "maps_to": "p2",
          "text": "哇，这个爽。"
        },
        {
          "start_sec": 1202.0,
          "end_sec": 1202.5,
          "speaker": "myself",
          "maps_to": "p1",
          "text": "哇。"
        },
        {
