        {
          "start_sec": 1598.3,
          "end_sec": 1599.3,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "他跑了！跑了！"
        },
        {
          "start_sec": 1602.2,
          "end_sec": 1604.2,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "我们是不是要跟他们打起来了？"
