        {
          "start_sec": 1585.1,
          "end_sec": 1586.4,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "老将越快我们越痛快。"
        },
        {
          "start_sec": 1586.5,
          "end_sec": 1588.8,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "不对！接上我十五军军长，他害我两年..."
