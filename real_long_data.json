          "start_sec": 1591.6,
          "end_sec": 1592.2,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "那打吧。"
        },
        {
          "start_sec": 1592.6,
          "end_sec": 1594.6,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "他们觉得南团是我们的最佳时机。"
        },
        {
          "start_sec": 1596.2,
          "end_sec": 1598.2,
          "speaker": "SPEAKER_01",
          "maps_to": null,
          "text": "他没有炸弹！他是不是拿错炸弹了？"
